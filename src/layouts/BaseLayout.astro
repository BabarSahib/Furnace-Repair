---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  breadcrumbs?: Breadcrumb[];
  schemaType?: string;
  serviceName?: string;
  cityName?: string;
  stateName?: string;
  serviceSchema?: Record<string, any>;
}

const {
  title,
  description,
  canonicalPath = '',
  breadcrumbs = [],
  schemaType = 'ServiceAreaBusiness',
  serviceName,
  cityName,
  stateName,
  serviceSchema
} = Astro.props;

const siteUrl = 'https://furnacefixpros.us';

// Sanitize canonical URL: strip query parameters (?utm=, ?sort=, ?page= etc.), hashes, lowercase, ensure single trailing slash
const rawPath = canonicalPath || Astro.url.pathname || '/';
const sanitizedPath = rawPath
  .split('?')[0]
  .split('#')[0]
  .toLowerCase()
  .trim()
  .replace(/^\/?/, '/')
  .replace(/\/+$/, '') + '/';

const canonicalUrl = `${siteUrl}${sanitizedPath}`;

// Master Brand / Organization Schema (Google-supported HVACBusiness subtype - No Reviews or Ratings)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "@id": `${siteUrl}/#organization`,
  "name": "FurnaceFix Pros",
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}/images/furnace-fix-pros-logo.png`,
  "image": `${siteUrl}/images/furnace-repair-og.jpg`,
  "telephone": "+18338030415",
  "email": "service@furnacefixpros.us",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ]
};

// LocalBusiness / Service Area Schema (Google-supported HVACBusiness - No Reviews or Ratings)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "@id": `${canonicalUrl}#localbusiness`,
  "name": cityName ? `FurnaceFix Pros - ${cityName}` : (stateName ? `FurnaceFix Pros - ${stateName}` : "FurnaceFix Pros"),
  "url": canonicalUrl,
  "telephone": "+18338030415",
  "email": "service@furnacefixpros.us",
  "priceRange": "$$",
  "image": `${siteUrl}/images/furnace-repair-og.jpg`,
  "parentOrganization": {
    "@id": `${siteUrl}/#organization`
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "US",
    ...(stateName ? { "addressRegion": stateName } : {}),
    ...(cityName ? { "addressLocality": cityName } : {})
  },
  "areaServed": cityName && stateName ? {
    "@type": "City",
    "name": `${cityName}, ${stateName}`
  } : (stateName ? {
    "@type": "State",
    "name": stateName
  } : {
    "@type": "Country",
    "name": "United States"
  }),
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ]
};

// BreadcrumbList Schema (Strict 3-Level Max)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.slice(0, 3).map((item, index) => {
    const rawUrl = item.url.startsWith('http') ? item.url : `${siteUrl}${item.url.startsWith('/') ? item.url : `/${item.url}`}`;
    const cleanItemUrl = rawUrl.split('?')[0].split('#')[0].replace(/\/+$/, '') + '/';
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "item": cleanItemUrl
    };
  })
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Robots & SERP Appearance -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="theme-color" content="#0f172a" />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="FurnaceFix Pros" />
  <meta property="og:image" content={`${siteUrl}/images/furnace-repair-og.jpg`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}/images/furnace-repair-og.jpg`} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ea580c'><path d='M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11zm0 15a3 3 0 0 1-3-3c0-1.8 1.5-3.5 3-5 1.5 1.5 3 3.2 3 5a3 3 0 0 1-3 3z'/></svg>" />

  <!-- JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {canonicalUrl !== `${siteUrl}/` && (
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}
  {serviceSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  )}
</head>
<body>
  <Header />

  {breadcrumbs && breadcrumbs.length > 0 && (
    <nav class="breadcrumb-wrapper" aria-label="Breadcrumb">
      <div class="container">
        <ol class="breadcrumb-list">
          {breadcrumbs.slice(0, 3).map((item, idx) => (
            <li class="breadcrumb-item">
              {idx === breadcrumbs.length - 1 ? (
                <span aria-current="page" style="font-weight: 600; color: var(--color-primary);">{item.name}</span>
              ) : (
                <>
                  <a href={item.url}>{item.name}</a>
                  <span class="breadcrumb-sep">/</span>
                </>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <Footer />

  <!-- Mobile Sticky Phone CTA Bar (Optimized for Mobile Conversion) -->
  <div class="sticky-mobile-bar">
    <a href="tel:+18338030415" class="btn btn-call sticky-call-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>(833) 803-0415</span>
    </a>
    <a href={canonicalUrl === `${siteUrl}/` ? "#contact-section" : "/contact-us/"} class="btn btn-primary sticky-estimate-btn">
      <span>Estimate</span>
    </a>
  </div>
</body>
</html>
