---
import services from '../data/services.json';
import states from '../data/states.json';

const currentYear = new Date().getFullYear();
const featuredStates = states.filter(s => ['texas', 'california', 'florida', 'illinois', 'new-york', 'ohio', 'pennsylvania', 'north-carolina'].includes(s.slug));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a href="/" class="logo-wrapper" style="color: #ffffff; margin-bottom: 1.25rem; display: inline-flex;">
          <div class="logo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11zm0 15a3 3 0 0 1-3-3c0-1.8 1.5-3.5 3-5 1.5 1.5 3 3.2 3 5a3 3 0 0 1-3 3z"/></svg>
          </div>
          <span>FurnaceFix<span style="color: var(--color-accent);">Pros</span></span>
        </a>
        <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
          Nationwide heating, furnace repair, and diagnostic technicians available 24/7. Upfront quotes, background-checked technicians, and genuine OEM heating components.
        </p>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: #f8fafc;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+18338030415" style="font-weight: 700; color: #ffffff;">+1 (833) 803-0415</a>
          </div>
          <div style="color: #94a3b8;">
            Dispatch Hours: Open 24 Hours / 7 Days a Week
          </div>
        </div>
      </div>

      <div class="footer-col">
        <h4>Our Heating Services</h4>
        <ul class="footer-links">
          <li><a href="/services/" style="font-weight: 600; color: var(--color-accent);">View All Services Hub →</a></li>
          {services.map((s) => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Popular State Hubs</h4>
        <ul class="footer-links">
          <li><a href="/locations/" style="font-weight: 600; color: var(--color-accent);">All 50 States Directory →</a></li>
          {featuredStates.map((st) => (
            <li><a href={`/${st.slug}/`}>{st.name} Furnace Repair</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company & Guides</h4>
        <ul class="footer-links">
          <li><a href="/about-us/">About FurnaceFix Pros</a></li>
          <li><a href="/contact-us/">Request Service / Estimate</a></li>
          <li><a href="/blog/">Heating Troubleshooting Guides</a></li>
          <li><a href="/locations/">Nationwide Coverage Map</a></li>
        </ul>
        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #1e293b;">
          <div style="font-size: 0.82rem; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Accepted Payments</div>
          <div style="color: #cbd5e1; font-size: 0.85rem;">Visa • Mastercard • Amex • Discover • Financing • Cash / Check</div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div>
        © {currentYear} FurnaceFix Pros. All rights reserved. Professional heating and furnace repair contractors nationwide.
      </div>
      <div style="display: flex; gap: 1.5rem;">
        <a href="/about-us/">About</a>
        <a href="/contact-us/">Contact</a>
        <a href="/services/">Services</a>
        <a href="/locations/">Locations</a>
      </div>
    </div>
  </div>
</footer>
