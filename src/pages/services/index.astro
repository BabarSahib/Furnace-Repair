---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContactForm from '../../components/ContactForm.astro';
import services from '../../data/services.json';

const servicesFaqs = [
  {
    question: "How do I know whether my furnace needs a repair or a complete replacement?",
    answer: "Generally, if your furnace is under 12–15 years old and the repair cost is less than half the price of a new system, repair is the most economical path. If the unit is over 15 years old, experiences recurring breakdowns, or has a cracked heat exchanger (which poses severe safety risks), system replacement provides superior energy savings and safety."
  },
  {
    question: "Do you service both natural gas, propane, and electric heating units?",
    answer: "Yes. Our heating technicians are trained and licensed to service natural gas furnaces, LP/propane systems, electric forced-air air handlers, and dual-fuel heat pump combinations across all major brands."
  },
  {
    question: "Are emergency diagnostic fees included in the final repair cost?",
    answer: "Our diagnostic fee covers the technician's travel and thorough physical and electrical testing to pinpoint the exact failure. When you approve the recommended repair work on the spot, we apply transparent flat-rate pricing with no hidden charges."
  },
  {
    question: "How often should a residential furnace receive routine maintenance?",
    answer: "Major furnace manufacturers and safety agencies strongly recommend scheduling a comprehensive furnace tune-up once per year, ideally in the autumn before winter temperatures peak. Regular maintenance maintains manufacturer warranty compliance and prevents over 85% of sudden mid-winter breakdowns."
  },
  {
    question: "Can an improperly installed furnace increase my monthly energy bills?",
    answer: "Yes. An improperly sized or improperly vented furnace will short-cycle, causing excessive fuel consumption, uneven room temperatures, and premature component wear. We perform precision Manual J heating load calculations to guarantee proper BTU sizing."
  }
];
// Services Hub Schema (No Reviews or Ratings)
const servicesHubSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://furnacefixpros.us/services/#service",
  "name": "Professional Heating & Furnace Repair Services",
  "serviceType": "HVAC and Furnace Repair",
  "description": "Comprehensive residential furnace repair, emergency diagnostics, routine maintenance tune-ups, installations, and system replacements nationwide.",
  "url": "https://furnacefixpros.us/services/",
  "provider": {
    "@type": "HVACBusiness",
    "@id": "https://furnacefixpros.us/#organization",
    "name": "FurnaceFix Pros",
    "telephone": "+18338030415",
    "url": "https://furnacefixpros.us/"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Heating Services Catalog",
    "itemListElement": services.map((s) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.name,
        "description": s.shortDescription,
        "url": `https://furnacefixpros.us/services/${s.slug}/`
      }
    }))
  }
};
---

<BaseLayout
  title="Professional Heating & Furnace Repair Services | FurnaceFix Pros"
  description="Explore comprehensive heating solutions from FurnaceFix Pros: emergency furnace repair, diagnostic troubleshooting, tune-ups, installations, and system replacements."
  canonicalPath="/services/"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Services", url: "/services/" }
  ]}
  serviceSchema={servicesHubSchema}
>
  <!-- Hero Banner -->
  <section class="hero-section" style="padding: 3.5rem 0;">
    <div class="container hero-content">
      <div class="badge-pill" style="background: rgba(234, 88, 12, 0.2); border-color: rgba(234, 88, 12, 0.4); color: #fdba74;">
        <span>Comprehensive Heating Solutions</span>
      </div>
      <h1 class="hero-title">Expert Furnace & Heating Services Nationwide</h1>
      <p class="hero-desc">
        Whether you are facing an unexpected freeze with zero heat or looking to cut monthly utility costs with a 96%+ AFUE system, our licensed technicians provide specialized, flat-rate heating services backed by genuine parts and written warranties.
      </p>
      <div class="btn-group">
        <a href="tel:+18338030415" class="btn btn-call btn-lg">Call (833) 803-0415</a>
        <a href="#contact-section" class="btn btn-secondary btn-lg">Schedule A Service Call</a>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- Complete Services Grid -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">Service Catalog</div>
        <h2>Our Core Heating & Furnace Capabilities</h2>
        <p>Click on any heating service below to view detailed diagnostic procedures, common failure symptoms, turnaround times, and replacement options.</p>
      </div>

      <div class="grid-cards">
        {services.map((s) => (
          <div class="card">
            <div class="card-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-4-2-7-6-11z"/></svg>
            </div>
            <h3 class="card-title">
              <a href={`/services/${s.slug}/`} style="color: var(--color-primary);">{s.name}</a>
            </h3>
            <p style="font-size: 0.9rem; font-weight: 700; color: var(--color-accent); margin-bottom: 0.5rem;">{s.tagline}</p>
            <p class="card-body">{s.shortDescription}</p>
            
            <div style="margin: 1rem 0; padding: 0.75rem; background-color: var(--color-surface-alt); border-radius: var(--radius-sm); font-size: 0.88rem;">
              <div style="font-weight: 700; color: var(--color-primary); margin-bottom: 0.25rem;">Typical Issues Addressed:</div>
              <ul style="margin: 0; padding-left: 1.2rem; color: var(--color-text-muted);">
                {s.commonProblems.slice(0, 2).map((prob) => (
                  <li style="margin-bottom: 0.2rem;">{prob}</li>
                ))}
              </ul>
            </div>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.85rem; font-weight: 700; color: var(--color-text-light);">{s.turnaround}</span>
              <a href={`/services/${s.slug}/`} class="btn btn-primary" style="padding: 0.45rem 0.9rem; font-size: 0.88rem;">
                View Details →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Process -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">Consistent Quality</div>
        <h2>Our Proven 4-Step Heating Service Protocol</h2>
        <p>Every furnace call adheres to rigorous technical standards to ensure safe operation, code compliance, and complete homeowner satisfaction.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
        <div class="card">
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-accent); margin-bottom: 0.5rem;">Step 1</div>
          <h3 class="card-title">Initial Diagnostic Test</h3>
          <p>We check electrical continuity, combustion gas pressures, and safety switch limit circuits to isolate the real issue.</p>
        </div>
        <div class="card">
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-accent); margin-bottom: 0.5rem;">Step 2</div>
          <h3 class="card-title">Clear Written Quote</h3>
          <p>You receive an upfront flat-rate price. No work begins until you understand the scope and approve the cost.</p>
        </div>
        <div class="card">
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-accent); margin-bottom: 0.5rem;">Step 3</div>
          <h3 class="card-title">Precision Component Repair</h3>
          <p>Technicians install genuine factory-certified parts with calibrated torque and electrical connections.</p>
        </div>
        <div class="card">
          <div style="font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--color-accent); margin-bottom: 0.5rem;">Step 4</div>
          <h3 class="card-title">Safety & CO Inspection</h3>
          <p>We run full heating cycles, measure air temperature rise, and test for toxic carbon monoxide emissions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <FaqAccordion 
    faqs={servicesFaqs} 
    title="Heating Service & Repair FAQs" 
    subtitle="Common questions regarding diagnostic procedures, furnace replacements, and repair warranties."
  />

  <!-- CTA Band -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container">
      <div class="cta-band">
        <h2>Restore Your Heat With One Phone Call</h2>
        <p>Connect with a certified technician right now for emergency repairs or scheduled maintenance.</p>
        <div class="btn-group" style="justify-content: center;">
          <a href="tel:+18338030415" class="btn btn-call btn-lg">Call (833) 803-0415</a>
          <a href="#contact-section" class="btn btn-secondary btn-lg">Book Service Online</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form & Map -->
  <ContactForm />
</BaseLayout>
