---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import blogPosts from '../../data/blogPosts.json';
import { getPostContent } from '../../utils/blogContentGenerator';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { post: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const postContentHtml = getPostContent(post);
const relatedPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.date,
  "dateModified": post.date,
  "author": {
    "@type": "Person",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "FurnaceFix Pros",
    "logo": {
      "@type": "ImageObject",
      "url": "https://furnacefixpros.com/images/furnace-fix-pros-logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://furnacefixpros.com/blog/${post.slug}/`
  }
};
---

<BaseLayout
  title={`${post.title} | FurnaceFix Pros`}
  description={post.excerpt}
  canonicalPath={`/blog/${post.slug}/`}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: post.title.slice(0, 45) + "...", url: `/blog/${post.slug}/` }
  ]}
>
  <!-- Injected Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Post Header -->
  <header style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 3.5rem 0 3rem 0;">
    <div class="container" style="max-width: 860px;">
      <div class="badge-pill" style="background: rgba(234, 88, 12, 0.2); border-color: rgba(234, 88, 12, 0.4); color: #fdba74;">
        <span>{post.category} • {post.readTime}</span>
      </div>
      <h1 style="color: #ffffff; font-size: clamp(1.85rem, 4vw, 2.75rem); line-height: 1.3; margin-bottom: 1.25rem;">
        {post.title}
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: #cbd5e1; font-size: 0.95rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span style="font-weight: 600; color: #ffffff;">{post.author}</span>
        </div>
        <span>•</span>
        <div>Published on {post.date}</div>
      </div>
    </div>
  </header>

  <!-- Post Body -->
  <div class="container" style="max-width: 860px; padding-top: 3.5rem; padding-bottom: 4rem;">
    <article class="blog-body" style="font-size: 1.1rem; line-height: 1.8; color: var(--color-text-main);" set:html={postContentHtml} />

    <!-- Author Bio Box -->
    <div style="margin-top: 4rem; padding: 2rem; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
      <div style="width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(135deg, #ea580c, #f97316); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; flex-shrink: 0;">
        HV
      </div>
      <div style="flex: 1;">
        <div style="font-weight: 800; font-size: 1.15rem; color: var(--color-primary);">{post.author}</div>
        <div style="font-size: 0.88rem; color: var(--color-accent); font-weight: 700; margin-bottom: 0.4rem;">Senior Heating & Combustion Diagnostics Specialist</div>
        <p style="font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.5; margin: 0;">
          With over 18 years of residential forced-air and hydronic heating diagnostic experience, Marcus oversees technical standards and field apprentice training for FurnaceFix Pros nationwide.
        </p>
      </div>
    </div>

    <!-- Related Articles -->
    <div style="margin-top: 4rem;">
      <h3 style="font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--color-primary);">Related Heating Guides</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
        {relatedPosts.map((rel) => (
          <div class="card" style="padding: 1.25rem;">
            <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); margin-bottom: 0.35rem; text-transform: uppercase;">{rel.category}</div>
            <h4 style="font-size: 1.05rem; line-height: 1.4; margin-bottom: 0.5rem;">
              <a href={`/blog/${rel.slug}/`} style="color: var(--color-primary);">{rel.title}</a>
            </h4>
            <div style="margin-top: auto; font-size: 0.85rem; font-weight: 700; color: var(--color-primary);">
              <a href={`/blog/${rel.slug}/`} style="color: var(--color-accent);">Read Guide →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA Band -->
  <section class="section section-alt" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container">
      <div class="cta-band">
        <h2>Facing A Heating Problem Right Now?</h2>
        <p>Our certified technicians are ready to dispatch today with fully stocked service trucks and flat-rate pricing.</p>
        <div class="btn-group" style="justify-content: center;">
          <a href="tel:+18338030415" class="btn btn-call btn-lg">Call (833) 803-0415</a>
          <a href="/contact-us/" class="btn btn-secondary btn-lg">Request Service Online</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
